# Funeral Plan Scale Readiness Diagnostic — environment configuration.
# Copy to .env for local development (Vercel serverless functions read process.env directly;
# `vercel env pull` will populate a matching .env.local when working against a linked project).

# Public site origin, used to build the secure result link included in the results email/webhook.
NEXT_PUBLIC_SITE_URL=https://www.aivideosystems.org

# Supabase (Postgres) — required for persistence and secure-token result revisits.
# Create a project at https://supabase.com, run supabase/migrations/*.sql against it, then set:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — required to send the results email. Get a key at https://resend.com.
RESEND_API_KEY=
DIAGNOSTIC_EMAIL_FROM="AI Video Systems <diagnostics@aivideosystems.org>"
# Comma-separated list. Optional — only used for the High Need + Strong/Priority Fit internal alert.
DIAGNOSTIC_INTERNAL_RECIPIENTS=

# Optional external booking link for the primary "Request a Deeper 90-Day Lead-to-Plan Analysis" CTA.
# If unset, an inline in-page request form is used instead (see api/diagnostic/analysis-request.ts).
DIAGNOSTIC_ANALYSIS_URL=

# Optional outbound webhook (e.g. to a CRM). Payload is HMAC-SHA256 signed when a secret is set.
DIAGNOSTIC_WEBHOOK_URL=
DIAGNOSTIC_WEBHOOK_SECRET=

# Optional — override where the contact-gate/results-page privacy & terms links point.
# Defaults to the in-site pages at /privacy and /terms if left unset.
PRIVACY_POLICY_URL=/privacy
TERMS_URL=/terms
VITE_PRIVACY_POLICY_URL=/privacy
VITE_TERMS_URL=/terms
