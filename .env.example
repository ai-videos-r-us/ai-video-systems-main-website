# Funeral Plan Scale Readiness Diagnostic — environment configuration.
# Copy to .env for local development (Vercel serverless functions read process.env directly;
# `vercel env pull` will populate a matching .env.local when working against a linked project).

# Public site origin, used to build the secure result link included in the results email/webhook.
NEXT_PUBLIC_SITE_URL=https://www.aivideosystems.org

# Supabase (Postgres) — required for persistence and secure-token result revisits.
# Create a project at https://supabase.com, run supabase/migrations/*.sql against it, then set:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — required to send the results email. Get a key at https://resend.com.
RESEND_API_KEY=
DIAGNOSTIC_EMAIL_FROM="AI Video Systems <diagnostics@aivideosystems.org>"
# Comma-separated list. Optional — only used for the High Need + Strong/Priority Fit internal alert.
DIAGNOSTIC_INTERNAL_RECIPIENTS=

# Optional external booking link for the primary "Request a Deeper 90-Day Lead-to-Plan Analysis" CTA.
# If unset, an inline in-page request form is used instead (see api/diagnostic/analysis-request.ts).
DIAGNOSTIC_ANALYSIS_URL=

# Optional outbound webhook (e.g. to a CRM). Payload is HMAC-SHA256 signed when a secret is set.
DIAGNOSTIC_WEBHOOK_URL=
DIAGNOSTIC_WEBHOOK_SECRET=

# Optional — override where the contact-gate/results-page privacy & terms links point.
# Defaults to the in-site pages at /privacy and /terms if left unset.
PRIVACY_POLICY_URL=/privacy
TERMS_URL=/terms
VITE_PRIVACY_POLICY_URL=/privacy
VITE_TERMS_URL=/terms

# --- Revenue Leak Calculator (/revenue-leak-calculator) --------------------------
# Where the gate's first-name + email captures are POSTed. Any endpoint that accepts
# JSON: Zapier / Make / n8n catch hook, GoHighLevel inbound webhook, your own CRM.
# If unset the page still works and captures are written to the Vercel function log,
# but nothing is delivered anywhere — set this before driving traffic.
LEAD_WEBHOOK_URL=

# Optional. When set, each request carries X-Lead-Signature: sha256=<hmac of the raw body>
# so the receiving end can verify the payload really came from us.
LEAD_WEBHOOK_SECRET=

# --- Funeral Plan Scale Readiness gate (/funeral-plan-scale-readiness) -----------
# Where that page's first-name + email captures are POSTed. Optional: the live Zapier catch
# hook is checked in as the default in lib/server/env.ts, so the page delivers without any
# configuration. Set this only to send funeral leads somewhere else (it takes precedence);
# the payload's `source` field ("funeral-plan-scale-readiness" vs "revenue-leak-calculator")
# is what tells the two pages' captures apart at the destination.
FUNERAL_LEAD_WEBHOOK_URL=

# Optional HMAC secret for the funeral destination. Only applies when FUNERAL_LEAD_WEBHOOK_URL
# is set — the default Zapier catch hook is sent unsigned, since it cannot verify a signature.
FUNERAL_LEAD_WEBHOOK_SECRET=

# REQUIRED in production. Signs the short-lived token that unlocks the calculator after
# someone completes the gate. Without it each serverless instance mints its own random
# secret, so visitors get re-gated whenever they hit a different instance.
# Generate one with:  openssl rand -hex 32
LEAD_ACCESS_SECRET=
