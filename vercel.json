{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/funeral-plan-scale-readiness/results/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/api/diagnostic/results/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/mortgage-clients",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mortgage-clients/",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|blog|lead-generation-for-|tools|results|guides|compare|alternatives|what-is-ai-video-systems|llms|about|meta-ads-lead-generation|qualified-lead-generation|video-lead-generation|lead-generation-for-funeral-homes|mortgage-broker-lead-generation).+)",
      "destination": "/app.html"
    }
  ],
  "crons": [
    {
      "path": "/api/indexnow",
      "schedule": "0 9 * * *"
    }
  ]
}
